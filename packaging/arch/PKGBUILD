# Maintainer: Michaeljhoni <desenvolvimento@gbonline.com.br>
#
# The AUR package fisga-git is this file and its .SRCINFO. After changing it, run
# makepkg --printsrcinfo > .SRCINFO (CI checks the two match).
# To build uncommitted work from a checkout instead of GitHub:
#   cd packaging/arch && FISGA_GIT="git+file://$(realpath ../..)" makepkg -si
# (makepkg clones what is committed in that checkout.)

pkgname=fisga-git
pkgver=r60.3cf63d2
pkgrel=1
pkgdesc='Download manager with multiple connections, queues, a scheduler and a browser extension'
arch=('x86_64' 'aarch64')
url='https://github.com/Michaeljhoni/Fisga'
license=('GPL-3.0-or-later')
depends=('gtk4' 'gcc-libs' 'glibc')
makedepends=('cargo' 'git')
optdepends=(
  'yt-dlp: videos from sites (YouTube and others)'
  'ffmpeg: merge audio and video from sites'
  'libnotify: notifications'
  'wl-clipboard: catch copied links on Wayland'
  'clamav: scan downloads with an antivirus'
  'libcanberra: sound when a download finishes'
)
provides=('fisga')
conflicts=('fisga')
# makepkg's GCC LTO turns ring's C code (TLS) into objects the Rust linker cannot
# read; the Rust side keeps its own LTO (Cargo.toml, profile.release).
options=('!lto')
source=("fisga::${FISGA_GIT:-git+https://github.com/Michaeljhoni/Fisga.git}")
sha256sums=('SKIP')

pkgver() {
  cd fisga
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd fisga
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd fisga
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release --workspace --bins
  bash extension/build.sh
}

check() {
  cd fisga
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo test --frozen --release --workspace
}

package() {
  cd fisga
  install -Dm755 target/release/fisga target/release/fisgad target/release/fisga-native-host target/release/fisga-gui \
    -t "$pkgdir/usr/bin"
  install -Dm644 crates/fisga-gui/data/io.fisga.Fisga.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 crates/fisga-gui/data/io.fisga.Fisga.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  for size in 32 48 64 128 256; do
    install -Dm644 "crates/fisga-gui/data/icons/$size/io.fisga.Fisga.png" -t "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps"
  done
  # The browser host for every user (Firefox, Chromium, Chrome, Brave, Edge, Vivaldi, LibreWolf).
  target/release/fisga install-hosts --system "$pkgdir" --host-path /usr/bin/fisga-native-host
  # The extension, to load unpacked: chrome://extensions or about:debugging.
  install -d "$pkgdir/usr/share/fisga"
  cp -r extension/dist "$pkgdir/usr/share/fisga/extension"
  install -Dm644 README.md docs/GUIA.md docs/CONTINUAR.md -t "$pkgdir/usr/share/doc/fisga"
}
